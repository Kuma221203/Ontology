@prefix : <http://nhamay.vn/ontology/sanxuat#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://nhamay.vn/ontology/sanxuat#> .

<http://nhamay.vn/ontology/sanxuat> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://nhamay.vn/ontology/sanxuat#belongsToStyle
:belongsToStyle rdf:type owl:ObjectProperty ;
                owl:inverseOf :hasSKU .


###  http://nhamay.vn/ontology/sanxuat#hasSKU
:hasSKU rdf:type owl:ObjectProperty ;
        rdfs:domain :Style ;
        rdfs:range :SKU .


###  http://nhamay.vn/ontology/sanxuat#partOfOrder
:partOfOrder rdf:type owl:ObjectProperty ;
             rdfs:domain :Style ;
             rdfs:range :Order .


#################################################################
#    Data properties
#################################################################

###  http://nhamay.vn/ontology/sanxuat#hasColor
:hasColor rdf:type owl:DatatypeProperty ;
          rdfs:domain :SKU ;
          rdfs:range xsd:string .


###  http://nhamay.vn/ontology/sanxuat#hasSizeLabel
:hasSizeLabel rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :SKU ;
              rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://nhamay.vn/ontology/sanxuat#CompleteSKU
:CompleteSKU rdf:type owl:Class ;
             owl:equivalentClass :SKU ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasColor ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasSizeLabel ;
                                   owl:someValuesFrom xsd:string
                                 ] .


###  http://nhamay.vn/ontology/sanxuat#Order
:Order rdf:type owl:Class ;
       owl:disjointWith :SKU .


###  http://nhamay.vn/ontology/sanxuat#SKU
:SKU rdf:type owl:Class ;
     rdfs:subClassOf [ rdf:type owl:Restriction ;
                       owl:onProperty :belongsToStyle ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Style
                     ] .


###  http://nhamay.vn/ontology/sanxuat#ShirtStyle
:ShirtStyle rdf:type owl:Class ;
            rdfs:subClassOf :Style .


###  http://nhamay.vn/ontology/sanxuat#Style
:Style rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasSKU ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :SKU
                       ] .


#################################################################
#    Individuals
#################################################################

###  http://nhamay.vn/ontology/sanxuat#Order123
:Order123 rdf:type owl:NamedIndividual ,
                   :Order .


###  http://nhamay.vn/ontology/sanxuat#SKU001
:SKU001 rdf:type owl:NamedIndividual ,
                 :SKU ;
        owl:differentFrom :SKU002 ,
                          :SKU003 ;
        :hasColor "red" ;
        :hasSizeLabel "M" .


###  http://nhamay.vn/ontology/sanxuat#SKU002
:SKU002 rdf:type owl:NamedIndividual ,
                 :SKU ;
        owl:differentFrom :SKU003 ;
        :hasColor "Blue" ;
        :hasSizeLabel "L" .


###  http://nhamay.vn/ontology/sanxuat#SKU003
:SKU003 rdf:type owl:NamedIndividual ,
                 :SKU ;
        :hasColor "white" ;
        :hasSizeLabel "XL" .


###  http://nhamay.vn/ontology/sanxuat#StyleA123
:StyleA123 rdf:type owl:NamedIndividual ,
                    :Style ;
           :hasSKU :SKU001 ,
                   :SKU002 ,
                   :SKU003 ;
           :partOfOrder :Order123 .


